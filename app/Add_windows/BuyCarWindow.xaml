<Window Name="BuyCWind" x:Class="Kursova.Add_windows.BuyCarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kursova.Add_windows"
        mc:Ignorable="d"
        Height="600" Width="400" WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown">
    <Border CornerRadius="20" Background="White" BorderBrush="Black" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0" Height="35" Grid.ColumnSpan="4" Margin="0,0,0,10" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="5"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.ColumnSpan="4" Background="Transparent" BorderBrush="Black" BorderThickness="0,0,0,2" Margin="0,0,0,0"></Border>
                <TextBlock Name="Inf" Text="Purchase registration" Foreground="Black" FontSize="17" FontFamily="Montserrat" FontWeight="Medium" Grid.Column="0" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Button x:Name="btnMinimize" BorderThickness="0" Content="-" Foreground="White" FontSize="16" FontFamily="Montserrat" Cursor="Hand" Grid.Column="1" Click="btnMinimize_Click" Style="{StaticResource RoundButtonTheme}"/>
                <Button x:Name="btnClose" BorderThickness="0" Content="X" Foreground="White" FontSize="12" FontFamily="Montserrat" Cursor="Hand" Grid.Column="2" Click="btnClose_Click"  Style="{StaticResource RoundButtonTheme}"/>
            </Grid>
            <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="Car VIN code" Foreground="Black" FontSize="17" Height="28" FontWeight="Medium" FontFamily="Montserrat" Margin="5,0,5,0" Padding="5,5,0,0"/>
                        <TextBlock Text="Car name" Foreground="Black" FontSize="17" Height="28" FontWeight="Medium" FontFamily="Montserrat" Margin="5,20,5,0" Padding="5,5,0,0"/>
                        <TextBlock Text="Car owner" Foreground="Black" FontSize="17" Height="28" FontWeight="Medium" FontFamily="Montserrat" Margin="5,20,5,0" Padding="5,5,0,0"/>
                        <Border Grid.Row="0" Grid.ColumnSpan="4" Background="Transparent" BorderBrush="Black" BorderThickness="0,0,0,2" Margin="0,30,0,0"></Border>

                        <TextBlock Text="Client" Foreground="Black" FontSize="17" Height="28" FontWeight="Medium" FontFamily="Montserrat" Margin="5,20,5,0" Padding="5,5,0,0"/>
                        <TextBlock Text="Name" Foreground="Black" FontSize="17" Height="28" FontWeight="Medium" FontFamily="Montserrat" Margin="5,20,5,0" Padding="5,5,0,0"/>
                        <TextBlock Text="Phone" Foreground="Black" FontSize="17" Height="28" FontWeight="Medium" FontFamily="Montserrat" Margin="5,20,5,0" Padding="5,5,0,0"/>
                        <TextBlock Text="Gender" Foreground="Black" FontSize="17" Height="28" FontWeight="Medium" FontFamily="Montserrat" Margin="5,20,5,0" Padding="5,5,0,0"/>
                        <TextBlock Text="Birthday" Foreground="Black" FontSize="17" Height="28" FontWeight="Medium" FontFamily="Montserrat" Margin="5,20,5,0" Padding="5,5,0,0"/>
                        <TextBlock Text="Address" Foreground="Black" FontSize="17" Height="28" FontWeight="Medium" FontFamily="Montserrat" Margin="5,20,5,0" Padding="5,5,0,0"/>
                        <TextBlock Text="RNOCPP" Foreground="Black" FontSize="17" Height="28" FontWeight="Medium" FontFamily="Montserrat" Margin="5,20,5,0" Padding="5,5,0,0"/>
                        <Border Grid.Row="0" Grid.ColumnSpan="4" Background="Transparent" BorderBrush="Black" BorderThickness="0,0,0,2" Margin="0,30,0,0"></Border>

                        <TextBlock Text="Employee" Foreground="Black" FontSize="17" Height="28" FontWeight="Medium" FontFamily="Montserrat" Margin="5,20,5,0" Padding="5,5,0,0"/>
                        <TextBlock Text="Sale date" Foreground="Black" FontSize="17" Height="28" FontWeight="Medium" FontFamily="Montserrat" Margin="5,20,5,0" Padding="5,5,0,0"/>
                        <TextBlock Text="Sale price" Foreground="Black" FontSize="17" Height="28" FontWeight="Medium" FontFamily="Montserrat" Margin="5,20,5,0" Padding="5,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <Border BorderBrush="Black" BorderThickness="2,2,2,2" Margin="5,0,5,0">
                            <TextBlock x:Name="TB1" Foreground="Black" FontSize="17" Height="24" FontWeight="Medium" FontFamily="Montserrat" Padding="5,5,0,0"/>
                        </Border>
                        <Border BorderBrush="Black" BorderThickness="2,2,2,2" Margin="5,20,5,0">
                            <TextBlock x:Name="TB2" Foreground="Black" FontSize="17" Height="24" FontWeight="Medium" FontFamily="Montserrat" Padding="5,5,0,0"/>
                        </Border>
                        <Border BorderBrush="Black" BorderThickness="2,2,2,2" Margin="5,20,5,0">
                            <TextBlock x:Name="TB3" Foreground="Black" FontSize="17" Height="24" FontWeight="Medium" FontFamily="Montserrat" Padding="5,5,0,0"/>
                        </Border>
                        <Border Grid.Row="0" Grid.ColumnSpan="4" Background="Transparent" BorderBrush="Black" BorderThickness="0,0,0,2" Margin="0,30,0,0"></Border>
                        <ComboBox x:Name="CB14" Text="New" IsEditable="True" FontSize="13" FontWeight="Medium" FontFamily="Montserrat" Background="Transparent" Foreground="Black" BorderBrush="White" BorderThickness="2,2,2,2" Height="28" VerticalContentAlignment="Center" Margin="5,20,5,0" Padding="10,0,0,0" ItemsSource="{Binding Names14}" SelectionChanged="CB1_Changed"/>
                        <TextBox x:Name="TB4" FontSize="13" FontWeight="Medium" FontFamily="Montserrat" Foreground="Black" CaretBrush="Black" BorderBrush="Black" BorderThickness="0,0,0,2" Height="28" VerticalContentAlignment="Center" Margin="5,20,5,0" Padding="10,0,0,0"/>
                        <TextBox x:Name="TB5" FontSize="13" FontWeight="Medium" FontFamily="Montserrat" Foreground="Black" CaretBrush="Black" BorderBrush="Black" BorderThickness="0,0,0,2" Height="28" VerticalContentAlignment="Center" Margin="5,20,5,0" Padding="30,0,0,0">
                            <TextBox.Background>
                                <ImageBrush ImageSource="/Add_windows/Знімок екрана 2024-05-26 135830 (Користувацькі).png" Stretch="None" AlignmentX="Left"/>
                            </TextBox.Background>
                        </TextBox>
                        <ComboBox x:Name="CB1" Text="Sex" FontSize="13" FontWeight="Medium" FontFamily="Montserrat" Background="Transparent" Foreground="Black" BorderBrush="White" BorderThickness="2,2,2,2" Height="28" VerticalContentAlignment="Center" Margin="5,20,5,0" Padding="10,0,0,0" ItemsSource="{Binding Names1}"/>
                        <DatePicker x:Name="TB6" Text="Year-month-day" FontSize="13" FontWeight="Medium" FontFamily="Montserrat" Foreground="Black" BorderBrush="Black" BorderThickness="0,0,0,2" Height="28" VerticalContentAlignment="Center" Margin="5,20,5,0" Padding="10,0,0,0"/>
                        <TextBox x:Name="TB10" FontSize="13" FontWeight="Medium" FontFamily="Montserrat" Foreground="Black" CaretBrush="Black" BorderBrush="Black" BorderThickness="0,0,0,2" Height="28" VerticalContentAlignment="Center" Margin="5,20,5,0" Padding="10,0,0,0"/>
                        <TextBox x:Name="TB7" FontSize="13" FontWeight="Medium" FontFamily="Montserrat" Foreground="Black" CaretBrush="Black" BorderBrush="Black" BorderThickness="0,0,0,2" Height="28" VerticalContentAlignment="Center" Margin="5,20,5,0" Padding="10,0,0,0"/>
                        <Border Grid.Row="0" Grid.ColumnSpan="4" Background="Transparent" BorderBrush="Black" BorderThickness="0,0,0,2" Margin="0,30,0,0"></Border>

                        <ComboBox x:Name="CB2" Text="Employee" IsEditable="True" FontSize="13" FontWeight="Medium" FontFamily="Montserrat" Background="Transparent" Foreground="Black" BorderBrush="White" BorderThickness="2,2,2,2" Height="28" VerticalContentAlignment="Center" Margin="5,20,5,0" Padding="10,0,0,0" ItemsSource="{Binding Names2}"/>
                        <DatePicker x:Name="TB8" Text="Year-month-day" FontSize="13" FontWeight="Medium" FontFamily="Montserrat" Foreground="Black" BorderBrush="Black" BorderThickness="0,0,0,2" Height="28" VerticalContentAlignment="Center" Margin="5,20,5,0" Padding="10,0,0,0"/>
                        <TextBox x:Name="TB9" FontSize="13" FontWeight="Medium" FontFamily="Montserrat" Foreground="Black" CaretBrush="Black" BorderBrush="Black" BorderThickness="0,0,0,2" Height="28" VerticalContentAlignment="Center" Margin="5,20,5,0" Padding="10,0,0,0"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Button x:Name="btnBuy" Grid.Row="2" Width="150" BorderThickness="0" Content="Buy" Foreground="White" FontSize="12" FontFamily="Montserrat" Cursor="Hand" HorizontalAlignment="Center" Click="btnBuy_Click" Style="{StaticResource NormalButtonTheme}" Margin="0,0,0,0"/>
        </Grid>
    </Border>
</Window>
